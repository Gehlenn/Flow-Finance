{
  "name": "flow-finance",
  "description": "Flow Finance - Intelligent Cash Flow Control App (release v0.9.7)",
  "private": true,
  "version": "0.9.7",
  "type": "module",
  "scripts": {
    "setup": "node setup.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "vault:sync": "node scripts/sync-obsidian-vault.mjs",
    "vault:summaries": "node scripts/generate-obsidian-summaries.mjs",
    "vault:refresh": "npm run vault:sync && npm run vault:summaries",
    "lint": "npm run type-check:app && npm run type-check:backend",
    "type-check": "npm run type-check:app && npm run type-check:backend",
    "type-check:app": "tsc -p tsconfig.app.json --noEmit",
    "type-check:backend": "npm --prefix backend run type-check",
    "quality:knip:root": "knip --config knip.json --workspace . --include files,dependencies,unlisted,unresolved --reporter json --no-progress",
    "quality:knip:backend": "knip --config knip.json --workspace backend --include files,dependencies,unlisted,unresolved --reporter json --no-progress",
    "quality:knip": "npm run quality:knip:root && npm run quality:knip:backend",
    "quality:cycles:install": "npm ci --prefix tools/architecture --ignore-scripts --no-audit --no-fund",
    "quality:cycles:app": "node tools/architecture/node_modules/madge/bin/cli.js --circular --json --extensions ts,tsx,js,jsx --ts-config tsconfig.app.json App.tsx AppWithAnalytics.tsx index.tsx components hooks pages services src utils models",
    "quality:cycles:backend": "node tools/architecture/node_modules/madge/bin/cli.js --circular --json --extensions ts,js --ts-config backend/tsconfig.json backend/src backend/shared",
    "quality:cycles": "npm run quality:cycles:install && npm run quality:cycles:app && npm run quality:cycles:backend",
    "quality:architecture": "npm run quality:knip && npm run quality:cycles",
    "docs:update": "node scripts/update-readme.js",
    "docs:check-links": "node scripts/check-doc-links.mjs",
    "docs:check-mojibake": "node scripts/check-mojibake.mjs",
    "deploy": "vercel --prod",
    "deploy:preview": "vercel",
    "teste": "npm test",
    "test": "node scripts/run-vitest-stable.mjs",
    "test:backend": "vitest run backend/tests/unit",
    "test:unit": "node scripts/run-vitest-stable.mjs",
    "test:firestore:rules": "node scripts/run-firestore-rules.mjs",
    "test:watch": "vitest --exclude tests/e2e/**",
    "test:coverage": "vitest run --coverage --exclude tests/e2e/** --exclude tests/firestore/** --passWithNoTests",
    "test:ci": "node scripts/run-vitest-stable.mjs",
    "test:critical": "npm run test:coverage:critical",
    "test:coverage:critical": "vitest run --config vitest.critical.config.ts",
    "validate:cfo:route": "node scripts/validate-cfo-route.mjs",
    "validate:e2e:matrix": "node scripts/validate-e2e-matrix.mjs",
    "validate:e2e:matrix:dry": "node scripts/validate-e2e-matrix.mjs --dry-run",
    "health:vercel": "node scripts/verify-vercel-observability.mjs https://flow-finance-backend.vercel.app",
    "health:published-headers": "node scripts/check-published-headers.mjs --strict",
    "health:csp-readiness": "node scripts/check-csp-readiness.mjs",
    "health:firestore-authority:static": "node scripts/check-firestore-authority-static.mjs",
    "health:visual-baseline": "node scripts/check-visual-baseline.mjs",
    "health:visual-diff": "node ./node_modules/@playwright/test/cli.js test tests/e2e/visual-diff.spec.ts --project=chromium --workers=1 --output=test-results/playwright-visual-diff",
    "health:target-performance": "node scripts/check-target-performance-evidence.mjs",
    "health:scale-readiness:ready": "node scripts/check-scale-readiness-prereqs.mjs",
    "health:scale-readiness": "node scripts/check-scale-readiness-evidence.mjs",
    "health:stripe-live-smoke": "node scripts/check-stripe-live-smoke.mjs",
    "health:io": "vitest run --pool=threads tests/health/io-integrations.health.test.ts",
    "health:runtime": "playwright test tests/e2e/runtime-console-health.spec.ts --project=chromium --workers=1",
    "health:runtime:mobile": "playwright test tests/e2e/runtime-console-health.spec.ts --project=\"Mobile Chrome\" --project=\"Mobile Safari\" --workers=1",
    "health:all": "npm run health:io ; npm run health:runtime ; npm run health:runtime:mobile",
    "visual:regression": "node scripts/capture-visual-regression.mjs",
    "health:activation-retention:ready": "node scripts/check-activation-retention-prereqs.mjs",
    "health:activation-retention:export": "node scripts/export-activation-retention-events.mjs",
    "health:activation-retention:refresh": "node scripts/refresh-activation-retention-evidence.mjs",
    "health:activation-retention": "node scripts/check-activation-retention-evidence.mjs",
    "health:habit-proof": "node scripts/check-habit-proof-evidence.mjs",
    "health:cohort-state": "node scripts/summarize-cohort-state.mjs",
    "health:ai-quality": "node scripts/check-ai-quality-evidence.mjs",
    "audit:claims": "node scripts/check-audit-claims.mjs",
    "audit:evidence": "node scripts/generate-audit-evidence-report.mjs",
    "health:launch-gates": "node scripts/check-public-launch-gates.mjs",
    "teste:e2e": "npm run test:e2e",
    "test:e2e": "playwright test",
    "db:reset": "node scripts/reset-database.mjs",
    "security:scan-secrets": "node scripts/scan-secrets.mjs",
    "setup:mobile:android": "cap add android && cap sync android",
    "setup:mobile:ios": "cap add ios && cap sync ios",
    "setup:mobile": "npm run setup:mobile:android && npm run setup:mobile:ios",
    "build:android": "npm run build && cap sync android && cap build android",
    "build:android:release": "npm run build && cap sync android && cap build android --prod",
    "build:ios": "npm run build && cap sync ios && cap build ios",
    "build:ios:release": "npm run build && cap sync ios && cap build ios --prod",
    "cap:build:android": "npx cap build android",
    "cap:build:ios": "npx cap build ios",
    "cap:sync": "npx cap sync",
    "health:auth-local": "node scripts/check-local-auth-readiness.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/ios": "8.3.0",
    "@sentry/react": "^10.47.0",
    "@vercel/analytics": "^2.0.1",
    "decimal.js": "^10.4.3",
    "esbuild": "^0.28.0",
    "firebase": "^12.9.0",
    "lucide-react": "1.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "recharts": "3.8.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.2.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "autoprefixer": "^10.4.27",
    "express": "^5.2.1",
    "firebase-tools": "^15.12.0",
    "jsdom": "^29.0.1",
    "knip": "5.80.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "@protobufjs/utf8": "^1.1.1",
    "protobufjs": "^7.5.8"
  }
}
