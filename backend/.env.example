# ─── API CONFIGURATION ──────────────────────────────────────────────────────

# Backend port (default: 3001)
PORT=3001

# Node environment (development | production | test)
NODE_ENV=development

# Versão do app — usada em /health, /api/version e /api/health
# Em produção, defina como variável de ambiente no painel do Vercel
APP_VERSION=0.9.6

# Frontend URL for CORS configuration
FRONTEND_URL=http://localhost:5173

# Origens adicionais permitidas pelo CORS (separadas por vírgula)
# Em produção no Vercel, adicionar a URL do frontend:
#   ALLOWED_ORIGINS=https://flow-finance.vercel.app,https://app.flowfinance.com
# O backend usa SameSite=None; Secure em NODE_ENV=production para
# permitir cookies cross-origin entre frontend e backend em domínios separados.
ALLOWED_ORIGINS=

# ─── AI & LLM CONFIGURATION ──────────────────────────────────────────────────

# Gemini API key (get it from https://aistudio.google.com/app/apikeys)
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use (default: gemini-2.0-flash or gemini-1.5-pro)
GEMINI_MODEL=gemini-2.0-flash

# ─── AUTHENTICATION ─────────────────────────────────────────────────────────

# JWT secret for signing tokens (use a strong random string in production)
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Access/refresh token expiration (JWT)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# OAuth (Google) scaffold
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/oauth/google/callback
OAUTH_STATE_TTL_SECONDS=600
OAUTH_MOCK_MODE=true

# Billing (SaaS)
ALLOW_MOCK_BILLING_UPDATES=false
SAAS_PRO_MONTHLY_PRICE_CENTS=4900

# Stripe (required for checkout/portal/webhook)
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_WEBHOOK_SECRET=

# Stripe live smoke (required only for published checkout verification)
STRIPE_LIVE_SMOKE_BACKEND_URL=
STRIPE_LIVE_SMOKE_RETURN_URL=
STRIPE_LIVE_SMOKE_WORKSPACE_ID=
STRIPE_LIVE_SMOKE_BEARER_TOKEN=
STRIPE_LIVE_SMOKE_COOKIE_HEADER=

# Feature Gates
# Open Finance via Pluggy costs >R$ 1.000/mês. Set to 'true' to temporarily disable.
# Infrastructure remains intact for future reactivation when revenue justifies cost
DISABLE_OPEN_FINANCE=true

# Billing standby
# While Stripe is paused, enable mock billing locally to validate plan UX.
ALLOW_MOCK_BILLING_UPDATES=true

# ─── RATE LIMITING ───────────────────────────────────────────────────────────

# Common limit: max requests per window
RATE_LIMIT_GENERAL_MAX=100
# Window in minutes
RATE_LIMIT_GENERAL_WINDOW=15

# AI endpoint limit: max requests per minute
RATE_LIMIT_AI_MAX=10
RATE_LIMIT_AI_WINDOW=1

# Auth endpoint limit: max requests per window
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW=15

# ─── LOGGING ─────────────────────────────────────────────────────────────────

# Log level (trace | debug | info | warn | error | fatal)
LOG_LEVEL=info

# Pretty-print logs in development (default: true in dev, false in prod)
LOG_PRETTY=true

# ─── DATABASE (Future Implementation) ─────────────────────────────────────────

# DATABASE_URL=postgresql://user:password@localhost:5432/flow_finance

# Firebase-first strategy for Open Finance persistence.
# Supported values: memory | postgres | firebase
CLOUD_SYNC_STORE_DRIVER=firebase
OPEN_FINANCE_STORE_DRIVER=firebase
OPEN_FINANCE_POSTGRES_ENABLED=false
DATABASE_URL=

# Firebase Admin credentials (required when OPEN_FINANCE_STORE_DRIVER=firebase)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=

# ─── MONITORING & OBSERVABILITY ──────────────────────────────────────────────

# Sentry DSN for error tracking (optional)
# SENTRY_DSN=https://your-project-dsn@sentry.io/project-id

# Enable Sentry in development (default: false)
# SENTRY_DEV_ENABLED=false

# New Relic license key (optional)
# NEW_RELIC_LICENSE_KEY=...

# ─── OPEN FINANCE / PLUGGY ────────────────────────────────────────────────────

# Set to 'pluggy' for real connections. Use 'mock' only for local persistence tests.
OPEN_FINANCE_PROVIDER=pluggy

# ⚠️  NEVER expose these in client-side code or version control.
# Get sandbox credentials at https://dashboard.pluggy.ai
# Replace the values below with your actual CLIENT_ID and CLIENT_SECRET.
PLUGGY_CLIENT_ID=your_pluggy_client_id_here
PLUGGY_CLIENT_SECRET=your_pluggy_client_secret_here

# Pluggy API base URL (default is production; use sandbox URL for testing)
PLUGGY_BASE_URL=https://api.pluggy.ai

# Optional: map your app's bankId slugs to Pluggy connector IDs (JSON).
# Find connector IDs at https://dashboard.pluggy.ai/connectors
# Example: {"nubank":201,"itau":176,"bradesco":212}
PLUGGY_BANK_CONNECTORS=

# Optional: default credentials for sandbox automated testing only.
# ⚠️  Never set real user credentials here.
# PLUGGY_DEFAULT_CREDENTIALS_JSON={"cpf":"012.345.678-90","password":"test1234"}

# Optional: protect the public webhook URL using a shared secret.
# Configure the Pluggy webhook URL as:
# https://your-domain/api/banking/webhooks/pluggy?secret=your_shared_secret
PLUGGY_WEBHOOK_SECRET=

# ─── BUSINESS INTEGRATIONS (PHASE 2) ─────────────────────────────────────────

# API keys accepted in header x-integration-key (comma-separated)
FLOW_EXTERNAL_INTEGRATION_KEYS=

# Optional HMAC secrets accepted for x-integration-signature validation (comma-separated)
# Signature format: sha256=<hmac_hex_of("<timestamp>.<rawBody>")>
FLOW_EXTERNAL_INTEGRATION_HMAC_SECRETS=

# Allowed timestamp skew in seconds for anti-replay protection
FLOW_EXTERNAL_INTEGRATION_MAX_SKEW_SECONDS=300

# Key-to-scope bindings (comma-separated):
# <integrationKey>|<workspaceId>|<sourceSystem>
# Example:
# FLOW_EXTERNAL_INTEGRATION_BINDINGS=key_live_ops|ws_123|n8n_clinic_ops,key_live_fin|ws_456|erp_main
FLOW_EXTERNAL_INTEGRATION_BINDINGS=

# ─── CLINIC AUTOMATION INTEGRATION ───────────────────────────────────────────

# Feature flags para ingestão da clínica
# true = aceita eventos, false = rejeita com 400
FF_CLINIC_INGEST=true

# true = auto-posta receitas confirmadas no Firestore ao receber payment_received
# false = apenas registra o evento para revisão manual
FF_CLINIC_AUTO_POST=false

# Tamanho máximo do payload da clínica em bytes (padrão: 262144 = 256 KB)
CLINIC_WEBHOOK_MAX_PAYLOAD_BYTES=262144

# Rate limit de borda por IP para o webhook da clínica (req/min, padrão: 300)
CLINIC_EDGE_RATE_LIMIT_MAX=300

# Rate limit autenticado por integração key+workspace (req/min, padrão: 200)
CLINIC_AUTH_RATE_LIMIT_MAX=200

# Versão do schema do envelope esperado pela clínica
# Atualmente: "1.0"
# CLINIC_SCHEMA_VERSION=1.0


